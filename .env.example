# SLOP ILLUSTRATED (Si.) — Living Edition Environment Configuration
NODE_ENV=development
HOST=127.0.0.1
PORT=3016
PUBLIC_ORIGIN=https://ussy.host

# SQLite database path (Drizzle + better-sqlite3, WAL mode)
DATABASE_PATH=./data/living-edition.sqlite

# Issue Draft Generator (npm run issue:draft)
# Optional: increases GitHub API rate limits; generator works unauthenticated or via gh CLI
GITHUB_TOKEN=
GITHUB_OWNER=mojomast

# Optional Gemini API key (used by issue:draft when set, and by runtime stubs when enabled)
# Never commit real keys; set in host environment or .env
GEMINI_API_KEY=
GEMINI_DRAFT_MODEL=gemini-2.5-flash-lite
GEMINI_EDITOR_MODEL=gemini-2.5-flash-lite

# Optional Runtime Feature Flags (disabled by default; stub interfaces active when false)
FEATURE_ASK_EDITOR=false
FEATURE_AI_ILLUSTRATION=false
FEATURE_AUDIO_EDITION=false
