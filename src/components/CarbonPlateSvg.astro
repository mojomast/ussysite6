---
interface Props {
  svgId: string;
  title?: string;
  accent?: string;
  secondary?: string;
}

const {
  svgId,
  title = 'Carbon Architectural Plate',
  accent = '#ff4422',
  secondary = '#3ddc97'
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 800 600"
  width="800"
  height="600"
  role="img"
  aria-label={title}
>
  <defs>
    <pattern id={`grid-${svgId}`} width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#222630" stroke-width="0.8" />
    </pattern>
    <linearGradient id={`bg-${svgId}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0b0d11" />
      <stop offset="100%" stop-color="#131720" />
    </linearGradient>
  </defs>

  <rect width="800" height="600" fill={`url(#bg-${svgId})`} />
  <rect width="800" height="600" fill={`url(#grid-${svgId})`} />
  <rect x="20" y="20" width="760" height="560" fill="none" stroke="#343a48" stroke-width="1.2" />

  <!-- Corner Registration Marks -->
  <path d="M20 44V20H44M756 20H780V44M20 556V580H44M756 580H780V556" fill="none" stroke={accent} stroke-width="2" />
  <text x="40" y="50" fill="#8b867a" font-family="JetBrains Mono, monospace" font-size="11">
    Si. CARBON PRESS // C·06 TECHNICAL LITHOGRAPH
  </text>
  <text x="760" y="50" fill={secondary} font-family="JetBrains Mono, monospace" font-size="11" text-anchor="end">
    {svgId.toUpperCase()}
  </text>

  {svgId === 'cover-carbon-hive' && (
    <g>
      <polygon points="400,115 510,178 510,305 400,368 290,305 290,178" fill="#151922" stroke={accent} stroke-width="2.2" />
      <polygon points="400,145 484,193 484,290 400,338 316,290 316,193" fill="none" stroke="#3c4354" stroke-width="1.2" stroke-dasharray="4 4" />
      <polygon points="225,210 285,245 285,315 225,350 165,315 165,245" fill="#10141c" stroke={secondary} stroke-width="1.6" />
      <polygon points="575,210 635,245 635,315 575,350 515,315 515,245" fill="#10141c" stroke={secondary} stroke-width="1.6" />
      <polygon points="312,365 372,400 372,470 312,505 252,470 252,400" fill="#10141c" stroke="#f5a623" stroke-width="1.6" />
      <polygon points="488,365 548,400 548,470 488,505 428,470 428,400" fill="#10141c" stroke="#38bdf8" stroke-width="1.6" />
      <circle cx="400" cy="242" r="34" fill="none" stroke={accent} stroke-width="2" />
      <circle cx="400" cy="242" r="8" fill={accent} />
      <path d="M285 280H316M484 280H515M355 342L335 375M445 342L465 375" stroke="#f3efe6" stroke-width="1.4" />
      <text x="400" y="212" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">C·06 ALLOTROPE</text>
      <text x="400" y="276" fill={secondary} font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">11 VERIFIED CELLS</text>
    </g>
  )}

  {(svgId === 'frontispiece-verify-gate' || svgId === 'plate-rizzstack') && (
    <g>
      <!-- Four Worker Tracks into BWRAP Verify Ring -->
      <path d="M80 170H340" stroke={secondary} stroke-width="3" />
      <path d="M80 245H340" stroke={secondary} stroke-width="3" />
      <path d="M80 325H340L445 430H710" fill="none" stroke="#f5a623" stroke-width="2.5" stroke-dasharray="7 5" />
      <path d="M80 400H340L425 495H710" fill="none" stroke={accent} stroke-width="2.8" />
      <path d="M440 208H715" stroke={secondary} stroke-width="4" />

      <circle cx="390" cy="245" r="78" fill="#0e1218" stroke="#f3efe6" stroke-width="2.2" />
      <circle cx="390" cy="245" r="58" fill="none" stroke={secondary} stroke-width="1.5" stroke-dasharray="5 4" />
      <text x="390" y="238" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="13" text-anchor="middle">BWRAP GATE</text>
      <text x="390" y="258" fill={secondary} font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">RED -&gt; GREEN</text>

      <text x="85" y="160" fill={secondary} font-family="JetBrains Mono, monospace" font-size="12">W1-PRICING [LEASE OK]</text>
      <text x="85" y="235" fill={secondary} font-family="JetBrains Mono, monospace" font-size="12">W2-LABELS [LEASE OK]</text>
      <text x="85" y="315" fill="#f5a623" font-family="JetBrains Mono, monospace" font-size="12">W3 [SCOPE_VIOLATION]</text>
      <text x="85" y="390" fill={accent} font-family="JetBrains Mono, monospace" font-size="12">W4 [TESTS_TAMPERED]</text>

      <rect x="530" y="182" width="185" height="52" fill="#10241c" stroke={secondary} stroke-width="1.6" />
      <text x="622" y="212" fill={secondary} font-family="JetBrains Mono, monospace" font-size="12" text-anchor="middle">INTEGRATED · SIGNED</text>

      <rect x="520" y="472" width="195" height="44" fill="#28110e" stroke={accent} stroke-width="1.6" />
      <text x="617" y="499" fill={accent} font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">QUARANTINE · REJECTED</text>
    </g>
  )}

  {svgId === 'plate-bundlebees' && (
    <g>
      {[0, 1, 2, 3].map((i) => (
        <g>
          <rect x="85" y={135 + i * 82} width="190" height="54" fill="#141923" stroke={secondary} stroke-width="1.5" />
          <text x="180" y={167 + i * 82} fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">
            {['bundlebees_status', 'bundlebees_dispatch', 'bundlebees_attempt', 'bundlebees_host_prompt'][i]}
          </text>
          <path d={`M275 ${162 + i * 82}H365`} stroke={secondary} stroke-width="1.6" />
        </g>
      ))}
      <rect x="365" y="155" width="150" height="250" fill="#181c26" stroke="#f5a623" stroke-width="2" />
      <text x="440" y="265" fill="#f5a623" font-family="JetBrains Mono, monospace" font-size="13" text-anchor="middle">585 TOKENS</text>
      <text x="440" y="288" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">CONTRACT GATE</text>
      <text x="440" y="310" fill={secondary} font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">1,284 CI TESTS</text>
      <path d="M515 280H585" stroke="#f3efe6" stroke-width="2" />
      <polygon points="650,205 715,242 715,318 650,355 585,318 585,242" fill="#102019" stroke={secondary} stroke-width="2" />
      <text x="650" y="276" fill={secondary} font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">bb-verify/</text>
      <text x="650" y="295" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">NO GIT PUSH</text>
    </g>
  )}

  {svgId === 'plate-hyvv' && (
    <g>
      <polygon points="400,110 545,192 545,358 400,440 255,358 255,192" fill="#12161f" stroke={accent} stroke-width="2.4" />
      <polygon points="400,155 505,215 505,335 400,395 295,335 295,215" fill="#0b0e14" stroke={secondary} stroke-width="1.5" />
      <rect x="330" y="235" width="140" height="82" fill="#1c1810" stroke={accent} stroke-width="1.8" />
      <text x="400" y="268" fill={accent} font-family="JetBrains Mono, monospace" font-size="12" text-anchor="middle">HOST KEY VAULT</text>
      <text x="400" y="290" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">POSIX 0600 · SHA-256</text>
      <text x="400" y="485" fill={secondary} font-family="JetBrains Mono, monospace" font-size="13" text-anchor="middle">/v1 ADDITIVE CONTRACT · hyvvcap1_ CAPABILITY</text>
    </g>
  )}

  {svgId === 'plate-orbit-cp' && (
    <g>
      <rect x="75" y="190" width="185" height="190" fill="#101824" stroke={accent} stroke-width="2" />
      <text x="167" y="268" fill={accent} font-family="JetBrains Mono, monospace" font-size="13" text-anchor="middle">TAILSCALE SERVE</text>
      <text x="167" y="292" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">127.0.0.1 LOOPBACK</text>
      <path d="M260 285H350" stroke={accent} stroke-width="2.5" />
      <rect x="350" y="165" width="190" height="240" fill="#141821" stroke="#f3efe6" stroke-width="2" />
      <text x="445" y="260" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="13" text-anchor="middle">ORBIT CONTROL</text>
      <text x="445" y="284" fill="#3ddc97" font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">node:sqlite · 0 DEPS</text>
      <text x="445" y="308" fill="#8b867a" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">:8787 SIDECAR</text>
      <path d="M540 285H620" stroke="#3ddc97" stroke-width="2" stroke-dasharray="5 4" />
      <rect x="620" y="215" width="115" height="140" fill="#121c18" stroke="#3ddc97" stroke-width="1.6" />
      <text x="677" y="282" fill="#3ddc97" font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">CONNECTOR</text>
      <text x="677" y="302" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">PULL INTENTS</text>
    </g>
  )}

  {svgId === 'plate-uirizz' && (
    <g>
      <rect x="95" y="135" width="280" height="290" fill="#131722" stroke={accent} stroke-width="2" />
      <text x="115" y="170" fill={accent} font-family="JetBrains Mono, monospace" font-size="12">SURFACE: ESPRESSO-COMPARE</text>
      <line x1="115" y1="186" x2="355" y2="186" stroke="#2d3342" stroke-width="1" />
      <rect x="115" y="205" width="72" height="135" fill="#1a2030" stroke="#394256" />
      <rect x="199" y="205" width="72" height="135" fill="#1a2030" stroke={secondary} />
      <rect x="283" y="205" width="72" height="135" fill="#1a2030" stroke="#394256" />
      <rect x="115" y="362" width="240" height="40" fill="#291c12" stroke={accent} />
      <text x="235" y="387" fill={accent} font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">CLICK -&gt; PENDING PETITION</text>
      <path d="M375 382H495" stroke={accent} stroke-width="2" stroke-dasharray="6 4" />
      <rect x="495" y="230" width="215" height="200" fill="#0f1e19" stroke={secondary} stroke-width="2.2" />
      <text x="602" y="305" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="12" text-anchor="middle">APPROVAL GATE</text>
      <text x="602" y="335" fill={secondary} font-family="JetBrains Mono, monospace" font-size="15" text-anchor="middle">TYPED &quot;YES&quot;</text>
      <text x="602" y="365" fill="#8b867a" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">40-SHA PIN REQUIRED</text>
    </g>
  )}

  {svgId === 'plate-higgsfield' && (
    <g>
      <rect x="80" y="220" width="150" height="140" fill="#191326" stroke={accent} stroke-width="2" />
      <text x="155" y="280" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="12" text-anchor="middle">manifest.json</text>
      <text x="155" y="304" fill={accent} font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">37 SKILLS · 70 ROUTES</text>
      <path d="M230 290H325" stroke={accent} stroke-width="2.2" />
      <circle cx="385" cy="290" r="60" fill="#161822" stroke={secondary} stroke-width="2" />
      <text x="385" y="285" fill={secondary} font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">STILLS FIRST</text>
      <text x="385" y="304" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">QA GATE</text>
      {[0, 1, 2, 3].map((k) => (
        <g>
          <path d={`M445 290L545 ${165 + k * 82}`} stroke="#8b867a" stroke-width="1.4" />
          <rect x="545" y={142 + k * 82} width="175" height="46" fill="#131722" stroke={k % 2 === 0 ? accent : secondary} stroke-width="1.5" />
          <text x="632" y={170 + k * 82} fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">
            {['FLUX3 KLEIN STILLS', 'LTX-2.5 TWO-PASS I2V', 'WAN ARC-LEFT-45', 'CHATTERBOX + BIREFNET'][k]}
          </text>
        </g>
      ))}
    </g>
  )}

  {svgId === 'plate-doppler' && (
    <g>
      <rect x="85" y="120" width="630" height="340" fill="#091319" stroke={accent} stroke-width="1.8" />
      {[0, 1, 2, 3, 4].map((h) => (
        <path
          d={`M 110 ${155 + h * 48} C 310 ${158 + h * 48}, 410 ${225 + h * 48}, 690 ${232 + h * 48}`}
          fill="none"
          stroke={h === 0 ? accent : secondary}
          stroke-width={h === 0 ? '3' : '1.6'}
          opacity={1 - h * 0.14}
        />
      ))}
      <line x1="395" y1="120" x2="395" y2="460" stroke="#f5a623" stroke-width="1.5" stroke-dasharray="5 5" />
      <text x="405" y="148" fill="#f5a623" font-family="JetBrains Mono, monospace" font-size="11">t_CPA · VITERBI FIT</text>
      <text x="105" y="438" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="11">4,000 Hz MONO · MAD WHITENED · HELD-OUT: 2/18 &lt; 3 KM</text>
    </g>
  )}

  {svgId === 'plate-eoh' && (
    <g>
      <circle cx="310" cy="295" r="155" fill="#0a1816" stroke={accent} stroke-width="2.2" />
      <ellipse cx="310" cy="295" rx="155" ry="58" fill="none" stroke={secondary} stroke-width="1.2" />
      <ellipse cx="310" cy="295" rx="68" ry="155" fill="none" stroke={secondary} stroke-width="1.2" />
      <circle cx="355" cy="245" r="7" fill="#ff4422" />
      <text x="370" y="249" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="11">JO62QJ · 145.500 MHz</text>
      <rect x="510" y="155" width="215" height="275" fill="#101620" stroke={secondary} stroke-width="1.8" />
      <text x="617" y="185" fill={secondary} font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">OPENWEBRX WATERFALL</text>
      {[0, 1, 2, 3, 4, 5, 6].map((row) => (
        <rect x="530" y={205 + row * 22} width="175" height="14" fill={row % 2 === 0 ? '#143832' : '#162c46'} />
      ))}
      <rect x="525" y="372" width="185" height="40" fill="#2a1215" stroke="#ff4422" />
      <text x="617" y="396" fill="#ff4422" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">POLICY: NO PERSON SEARCH</text>
    </g>
  )}

  {svgId === 'plate-photopart' && (
    <g>
      <circle cx="215" cy="295" r="78" fill="#1b1814" stroke="#f5a623" stroke-width="2" />
      <text x="215" y="292" fill="#f5a623" font-family="JetBrains Mono, monospace" font-size="12" text-anchor="middle">COIN REF</text>
      <text x="215" y="312" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">PX / MM SCALE</text>
      <circle cx="505" cy="295" r="118" fill="#121b18" stroke={secondary} stroke-width="2.5" stroke-dasharray="14 8" />
      <circle cx="505" cy="295" r="88" fill="#0d1117" stroke={accent} stroke-width="2" />
      <circle cx="505" cy="295" r="34" fill="#0b0d11" stroke="#f3efe6" stroke-width="2" />
      <text x="505" y="452" fill={secondary} font-family="JetBrains Mono, monospace" font-size="12" text-anchor="middle">spur_gear TEMPLATE · WATERTIGHT STL</text>
      <text x="505" y="474" fill={accent} font-family="JetBrains Mono, monospace" font-size="11" text-anchor="middle">gear_steer.py: NO 40-TURN TROCHOID SCRIPTS</text>
    </g>
  )}

  {svgId === 'plate-templeos' && (
    <g>
      <rect x="135" y="115" width="530" height="350" fill="#0000aa" stroke="#ffffff" stroke-width="3" />
      <rect x="147" y="127" width="506" height="28" fill="#00aaaa" />
      <text x="160" y="146" fill="#000000" font-family="JetBrains Mono, monospace" font-size="13">TEMPLE OF HERMES 0.1.3 · 640x480 · 16 COLORS · -nic none</text>
      <text x="162" y="195" fill="#ffffff" font-family="JetBrains Mono, monospace" font-size="14">T:/Home&gt; U0 Main() &#123; &quot;Hello from COM1 HRPC\n&quot;; &#125;</text>
      <text x="162" y="230" fill="#55ffff" font-family="JetBrains Mono, monospace" font-size="13">QMP + VNC + COM1 UNIX SOCKETS · ~414 VISUAL TOKENS</text>
      <rect x="162" y="385" width="476" height="52" fill="#0b0d11" stroke={accent} stroke-width="1.8" />
      <text x="400" y="416" fill={accent} font-family="JetBrains Mono, monospace" font-size="12" text-anchor="middle">SHARED SCREEN: HUMAN INPUT -&gt; 2.0s AGENT YIELD</text>
    </g>
  )}

  {svgId === 'plate-jackpot' && (
    <g>
      <rect x="155" y="105" width="490" height="90" fill="#1a1418" stroke={secondary} stroke-width="2" />
      <text x="400" y="156" fill={secondary} font-family="JetBrains Mono, monospace" font-size="16" text-anchor="middle">[ 7 ]   [ BULLION ]   [ 7 ]</text>
      {[0, 1, 2, 3, 4].map((col) => (
        <g>
          <circle cx={240 + col * 80} cy="245" r="7" fill={secondary} />
          <circle cx={280 + col * 60} cy="295" r="7" fill="#f3efe6" />
        </g>
      ))}
      <rect x="180" y="345" width="440" height="52" fill="#171b24" stroke="#f3efe6" stroke-width="2" />
      <text x="400" y="376" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="12" text-anchor="middle">RECIPROCATING DOZER SHELF · 226 DETERMINISTIC TESTS</text>
      <line x1="150" y1="432" x2="650" y2="432" stroke={accent} stroke-width="3" stroke-dasharray="10 6" />
      <text x="400" y="465" fill={accent} font-family="JetBrains Mono, monospace" font-size="13" text-anchor="middle">MIDAS LIP SENSOR — BANKED ONLY PAST THIS EDGE</text>
    </g>
  )}

  {![
    'cover-carbon-hive',
    'frontispiece-verify-gate',
    'plate-rizzstack',
    'plate-bundlebees',
    'plate-hyvv',
    'plate-orbit-cp',
    'plate-uirizz',
    'plate-higgsfield',
    'plate-doppler',
    'plate-eoh',
    'plate-photopart',
    'plate-templeos',
    'plate-jackpot'
  ].includes(svgId) && (
    <g>
      <circle cx="400" cy="290" r="120" fill="none" stroke={accent} stroke-width="2" />
      <circle cx="400" cy="290" r="75" fill="none" stroke={secondary} stroke-width="1.5" stroke-dasharray="6 4" />
      <text x="400" y="295" fill="#f3efe6" font-family="JetBrains Mono, monospace" font-size="14" text-anchor="middle">{title}</text>
    </g>
  )}

  <text x="40" y="562" fill="#f3efe6" font-family="Georgia, serif" font-size="16" font-style="italic">{title}</text>
  <text x="760" y="562" fill="#8b867a" font-family="JetBrains Mono, monospace" font-size="11" text-anchor="end">CONCEPTUAL SCHEMATIC · NOT TELEMETRY</text>
</svg>
