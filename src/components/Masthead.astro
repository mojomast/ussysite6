---
import { stripBase, withBase } from '../lib/paths';
import { getCollection } from 'astro:content';
import { buildIssueFolios } from '../lib/folio';
import PressControls from './islands/PressControls.svelte';

interface Props {
  currentPath?: string;
}

const { currentPath: rawPath = Astro.url.pathname } = Astro.props;
const currentPath = stripBase(rawPath).replace(/(.)\/$/, '$1');

const allArticles = await getCollection('articles');
const byIssue = new Map<string, typeof allArticles>();
for (const entry of allArticles) {
  const list = byIssue.get(entry.data.issueNumber) || [];
  list.push(entry);
  byIssue.set(entry.data.issueNumber, list);
}

const searchCatalog = allArticles
  .sort((a, b) => b.data.issueNumber.localeCompare(a.data.issueNumber) || a.data.index - b.data.index)
  .map((entry) => {
    const issueArts = (byIssue.get(entry.data.issueNumber) || []).map((a) => a.data);
    const folios = buildIssueFolios(entry.data.issueNumber, issueArts);
    const f = folios.find((x) => x.articleSlug === entry.data.articleSlug);
    return {
      issueNumber: entry.data.issueNumber,
      articleSlug: entry.data.articleSlug,
      readerServiceNo: entry.data.readerServiceNo,
      folioCode: f?.folioCode || '00',
      title: entry.data.title,
      headline: entry.data.headline,
      category: entry.data.category,
      techStack: entry.data.techStack,
      flexiFreqs: entry.data.flexiFreqs
    };
  });

const isCurrent = (prefix: string) =>
  prefix === '/'
    ? currentPath === '/'
    : currentPath === prefix || currentPath.startsWith(`${prefix}/`);
---

<header class="press-masthead vt-masthead">
  <div class="carbon-sheet press-masthead-inner">
    <div class="brand-cluster">
      <a href={withBase('/')} class="si-badge" aria-label="Slop Illustrated, front page">
        Si<span>.</span>
      </a>
      <div class="brand-imprint">
        <a href={withBase('/')} class="brand-title">Slop Illustrated</a>
        <span class="datum-tag">Software, mostly honest · Vol. 1</span>
      </div>
    </div>

    <nav class="primary-nav" aria-label="Sections">
      <a class="nav-link" href={withBase('/')} aria-current={isCurrent('/') ? 'page' : undefined}>
        Front Page
      </a>
      <a class="nav-link" href={withBase('/issues/02')} aria-current={isCurrent('/issues/02') ? 'page' : undefined}>
        Issue 02<span class="nav-link-badge">Wet ink</span>
      </a>
      <a class="nav-link" href={withBase('/issues/01')} aria-current={isCurrent('/issues/01') ? 'page' : undefined}>
        Issue 01
      </a>
      <a class="nav-link" href={withBase('/issues')} aria-current={currentPath === '/issues' ? 'page' : undefined}>
        Back Issues
      </a>
      <a class="nav-link" href={withBase('/source-room')} aria-current={isCurrent('/source-room') ? 'page' : undefined}>
        Source Room
      </a>
      <a class="nav-link" href={withBase('/about')} aria-current={isCurrent('/about') ? 'page' : undefined}>
        About
      </a>
    </nav>

    <div class="press-controls-wrap">
      <PressControls client:load catalog={searchCatalog} />
    </div>
  </div>
</header>
