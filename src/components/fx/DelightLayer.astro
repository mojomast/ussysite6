---
/* Wave 9 · Delight layer. Mounted near the end of <body> on every page.
 * Decorative layers stay aria-hidden="true" and pointer-events: none; the Max Rizz
 * exit pill is a real keyboard-reachable button and state changes announce politely.
 */
const confettiGlyphs = [
  '¶', '★', '§', '✦', '†', '◆', '※', '‡', '★', '¶', '✦', '§', '◆', '※',
  '★', '¶', '‡', '✦', '§', '◆', '†', '★', '※', '¶', '✦', '§', '◆', '★'
];
const leftSorts = ['S', 'i', '¶', '§', 'C', '6', '※'];
const rightSorts = ['g', 'e', 'm', 'a', '4', '†', '★'];
---

<div class="fx-delight-root" data-fx-delight-root>
  <!-- Polite live region for screen-reader state announcements -->
  <div class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-fx-live></div>

  <!-- 1. MAXIMUM RIZZ scanlines & persistent overdrive frame -->
  <div class="fx-rizz-scanlines" aria-hidden="true"></div>

  <!-- 1b. MAXIMUM RIZZ full-screen announcement card & confetti burst -->
  <div class="fx-rizz-stage" data-fx-rizz-card aria-hidden="true" hidden>
    <div class="fx-rizz-confetti">
      {confettiGlyphs.map((glyph) => (
        <span class="fx-rizz-bit">{glyph}</span>
      ))}
    </div>
    <div class="fx-rizz-card">
      <div class="fx-rizz-card-bar">
        <span>EDITOR’S NOTE · PRESS OVERDRIVE</span>
        <span>NOT RECOMMENDED</span>
      </div>
      <div class="fx-rizz-card-body">
        <p class="fx-rizz-kicker">VOL. 01 · UNSANCTIONED SPECIMEN</p>
        <p class="fx-rizz-title">
          <span class="fx-rizz-title-top">MAXIMUM</span>
          <span class="fx-rizz-title-bot">RIZZ</span>
        </p>
        <p class="fx-rizz-note">
          We regret to inform you that this mode exists. The editorial desk advised against it; the neon tubes overruled the desk.
        </p>
      </div>
      <div class="fx-rizz-card-foot">
        <span>GILT RULES · LIVE HUE DRIFT · SCANLINES</span>
        <span>ESC TO CALM DOWN</span>
      </div>
    </div>
  </div>

  <!-- 1c. Persistent keyboard-reachable exit pill while Max Rizz is active -->
  <div class="fx-rizz-pill-wrap" data-fx-rizz-pill hidden>
    <button type="button" class="fx-rizz-pill" data-fx-rizz-off>
      <span class="fx-rizz-pill-dot" aria-hidden="true"></span>
      <span>Max rizz · Esc to calm down</span>
    </button>
  </div>

  <!-- 2. Printer's devil (ambient bee / ink-devil wandering the outer margin, full tier only) -->
  <div class="fx-devil-lane" data-fx-devil-lane aria-hidden="true" hidden>
    <div class="fx-devil-sprite" data-fx-devil-sprite>
      <svg class="fx-devil-svg" viewBox="0 0 36 36" width="32" height="32" focusable="false">
        <g class="fx-devil-wings">
          <ellipse cx="14" cy="11" rx="7" ry="4" transform="rotate(-24 14 11)" fill="rgba(34, 243, 230, 0.38)" stroke="#22f3e6" stroke-width="1" />
          <ellipse cx="22" cy="11" rx="7" ry="4" transform="rotate(24 22 11)" fill="rgba(34, 243, 230, 0.38)" stroke="#22f3e6" stroke-width="1" />
        </g>
        <!-- Brass-and-soot hive bee body with an ink-nib tail -->
        <ellipse cx="18" cy="20" rx="8.5" ry="6.2" fill="#e8c36a" stroke="#0b0c0e" stroke-width="1.3" />
        <path d="M13 15.2 V24.8 M18 13.8 V26.2 M23 15.5 V24.5" stroke="#0b0c0e" stroke-width="2" />
        <circle cx="25.5" cy="18.5" r="2.8" fill="#181b21" stroke="#e8c36a" stroke-width="1" />
        <circle cx="26.4" cy="17.8" r="0.8" fill="#ff5a3c" />
        <!-- Antennae -->
        <path d="M26.5 16 Q29 12 31.5 12.5 M27.5 17.5 Q31 15 33 16.5" fill="none" stroke="#e8c36a" stroke-width="1.1" stroke-linecap="round" />
        <!-- Fountain-pen nib stinger -->
        <path d="M9.5 20 L3.5 22 L9.5 22.8 Z" fill="#ff5a3c" />
      </svg>
    </div>
  </div>

  <!-- 3. Seasonal & time-of-day decorative touches (all tiers) -->
  <div class="fx-lamplight-vignette" aria-hidden="true"></div>

  <div class="fx-december-sorts" aria-hidden="true">
    <div class="fx-sorts-col fx-sorts-col--left">
      {leftSorts.map((ch) => (
        <span class="fx-type-sort">{ch}</span>
      ))}
    </div>
    <div class="fx-sorts-col fx-sorts-col--right">
      {rightSorts.map((ch) => (
        <span class="fx-type-sort">{ch}</span>
      ))}
    </div>
  </div>

  <div class="fx-press-day-ribbon" aria-hidden="true">
    <span class="fx-press-day-mark">◆</span>
    <span>PRESS DAY · 23RD</span>
  </div>

  <!-- 4a. Shift+click Si. badge ink blot & drips -->
  <div class="fx-ink-blot" data-fx-ink-blot aria-hidden="true" hidden>
    <svg class="fx-ink-blot-svg" viewBox="0 0 200 340" width="200" height="340" focusable="false">
      <g class="fx-ink-core">
        <path d="M98 44 C118 30, 146 42, 140 66 C158 76, 152 104, 130 104 C122 122, 92 124, 84 106 C60 110, 48 84, 62 66 C56 44, 82 32, 98 44 Z" fill="currentColor" />
        <circle cx="52" cy="48" r="7" fill="currentColor" />
        <circle cx="156" cy="54" r="5" fill="currentColor" />
        <circle cx="144" cy="116" r="6" fill="currentColor" />
        <circle cx="64" cy="118" r="4" fill="currentColor" />
        <circle cx="38" cy="78" r="3.5" fill="currentColor" />
        <circle cx="166" cy="86" r="3" fill="currentColor" />
      </g>
      <g class="fx-ink-drips">
        <path class="fx-ink-drip fx-ink-drip--1" d="M74 96 C74 148, 70 198, 74 248 C76 260, 82 260, 82 248 C82 198, 84 148, 84 96 Z" fill="currentColor" />
        <path class="fx-ink-drip fx-ink-drip--2" d="M97 104 C96 176, 94 246, 97 314 C99 330, 107 330, 108 314 C108 246, 108 176, 108 104 Z" fill="currentColor" />
        <path class="fx-ink-drip fx-ink-drip--3" d="M122 98 C122 142, 120 184, 122 224 C124 236, 130 236, 130 224 C130 184, 131 142, 131 98 Z" fill="currentColor" />
        <path class="fx-ink-drip fx-ink-drip--4" d="M140 94 C140 124, 139 152, 141 178 C142 186, 147 186, 147 178 C147 152, 147 124, 147 94 Z" fill="currentColor" />
      </g>
    </svg>
  </div>

  <!-- 4b. Proofreader overlay margin marks & registration ticks -->
  <div class="fx-proof-overlay" aria-hidden="true">
    <div class="fx-proof-margin fx-proof-margin--left">
      <span>stet</span>
      <span>¶</span>
      <span>₰</span>
      <span>#</span>
      <span>≡</span>
      <span>wf</span>
    </div>
    <div class="fx-proof-margin fx-proof-margin--right">
      <span>PROOF · GALLEY</span>
      <span>+1pt lead</span>
      <span>sp?</span>
      <span>tr.</span>
      <span>ESC EXIT</span>
    </div>
  </div>
</div>
