---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/opus.css';
import '../styles/motion.css';
import Masthead from '../components/Masthead.astro';
import FooterColophon from '../components/FooterColophon.astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title,
  description = 'Slop Illustrated is a magazine about software made by one person and a crew of agents. Every claim links to the commit it came from. It knows it is written with AI, and it checks.',
  canonicalPath = Astro.url.pathname
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site || 'https://ussy.host').toString();
---

<!doctype html>
<html lang="en" data-stock="graphite" data-grid="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Slop Illustrated" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <link rel="stylesheet" href="/vt-names.css" />
    <link rel="expect" href="#page-end" blocking="render" />
    <script is:inline src="/motion-boot.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Space+Grotesk:wght@500;600;700&family=Syne:wght@400..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to the reading</a>
    <div class="scroll-progress-track" aria-hidden="true">
      <div class="scroll-progress-bar"></div>
    </div>

    <Masthead currentPath={Astro.url.pathname} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <div id="page-end" hidden></div>

    <FooterColophon />
    <script>
      import '../scripts/reading-tracker.ts';
    </script>
  </body>
</html>
