[Unit]
Description=SLOP ILLUSTRATED (Si.) // Living Edition Hono + SQLite Backend
After=network.target

[Service]
Type=simple
User=mojo
WorkingDirectory=/home/mojo/projects/ussysite6
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3016
Environment=PUBLIC_ORIGIN=https://ussy.host
Environment=DATABASE_PATH=/home/mojo/projects/ussysite6/data/living-edition.sqlite
EnvironmentFile=-/etc/ussysite6/env
ExecStart=/home/mojo/.local/bin/node /home/mojo/projects/ussysite6/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
